 /* wallust template - colors-rofi */

* {
active-background: #AD8245;
active-foreground: #FBF2DC;
normal-background: #191616;
normal-foreground: #FBF2DC;
urgent-background: #C19895;
urgent-foreground: #FBF2DC;

alternate-active-background: #A2837B;
alternate-active-foreground: #FBF2DC;
alternate-normal-background: #191616;
alternate-normal-foreground: #FBF2DC;
alternate-urgent-background: #191616;
alternate-urgent-foreground: #FBF2DC;

selected-active-background: #AD8245;
selected-active-foreground: #191616;
selected-normal-background: #AD8245;
selected-normal-foreground: #191616;
selected-urgent-background: #A2837B;
selected-urgent-foreground: #191616;

background-color: #191616;
background: rgba(0,0,0,0.7);
foreground: #FBF2DC;
border-color: #AD8245;

color0: #403D3C;
color1: #69605F;
color2: #6E6564;
color3: #79625C;
color4: #826234;
color5: #917270;
color6: #B7A475;
color7: #F1E4C5;
color8: #A9A08A;
color9: #8C7F7F;
color10: #928685;
color11: #A2837B;
color12: #AD8245;
color13: #C19895;
color14: #F4DA9C;
color15: #F1E4C5;


}


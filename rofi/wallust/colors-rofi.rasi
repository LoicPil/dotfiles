 /* wallust template - colors-rofi */

* {
active-background: #E57A59;
active-foreground: #F1F0F3;
normal-background: #0F100F;
normal-foreground: #F1F0F3;
urgent-background: #F9C46A;
urgent-foreground: #F1F0F3;

alternate-active-background: #AA8657;
alternate-active-foreground: #F1F0F3;
alternate-normal-background: #0F100F;
alternate-normal-foreground: #F1F0F3;
alternate-urgent-background: #0F100F;
alternate-urgent-foreground: #F1F0F3;

selected-active-background: #F9C46A;
selected-active-foreground: #F1F0F3;
selected-normal-background: #F9C46A;
selected-normal-foreground: #F1F0F3;
selected-urgent-background: #F9C46A;
selected-urgent-foreground: #F1F0F3;

background-color: #0F100F;
background: rgba(0,0,0,0.7);
foreground: #F1F0F3;
border-color: #E57A59;

color0: #383938;
color1: #785F3E;
color2: #71646C;
color3: #7F6441;
color4: #AC5B43;
color5: #BB9350;
color6: #A2A0A6;
color7: #E3E1E5;
color8: #9F9EA1;
color9: #A17E53;
color10: #968590;
color11: #AA8657;
color12: #E57A59;
color13: #F9C46A;
color14: #D8D5DD;
color15: #E3E1E5;


}


 /* wallust template - colors-rofi */

* {
active-background: #539DCB;
active-foreground: #FBF1F5;
normal-background: #2B2E2E;
normal-foreground: #FBF1F5;
urgent-background: #57A4D5;
urgent-foreground: #FBF1F5;

alternate-active-background: #3A6A83;
alternate-active-foreground: #FBF1F5;
alternate-normal-background: #2B2E2E;
alternate-normal-foreground: #FBF1F5;
alternate-urgent-background: #2B2E2E;
alternate-urgent-foreground: #FBF1F5;

selected-active-background: #57A4D5;
selected-active-foreground: #FBF1F5;
selected-normal-background: #57A4D5;
selected-normal-foreground: #FBF1F5;
selected-urgent-background: #539DCB;
selected-urgent-foreground: #FBF1F5;

background-color: #2B2E2E;
background: rgba(0,0,0,0.7);
foreground: #FBF1F5;
border-color: #539DCB;

color0: #4F5353;
color1: #182A2D;
color2: #055071;
color3: #2B5063;
color4: #3F7698;
color5: #417BA0;
color6: #B6A1A9;
color7: #F1E2E8;
color8: #A89EA2;
color9: #21383C;
color10: #076A97;
color11: #3A6A83;

 /* wallust template - colors-rofi */

* {
active-background: #2C58A0;
active-foreground: #FDF1CC;
normal-background: #1F1F20;
normal-foreground: #FDF1CC;
urgent-background: #BE5E35;
urgent-foreground: #FDF1CC;

alternate-active-background: #59372E;
alternate-active-foreground: #FDF1CC;
alternate-normal-background: #1F1F20;
alternate-normal-foreground: #FDF1CC;
alternate-urgent-background: #1F1F20;
alternate-urgent-foreground: #FDF1CC;

selected-active-background: #BE5E35;
selected-active-foreground: #FDF1CC;
selected-normal-background: #BE5E35;
selected-normal-foreground: #FDF1CC;
selected-urgent-background: #2C58A0;

 /* wallust template - colors-rofi */

* {
active-background: #FC9867;
active-foreground: #FCFCFA;
normal-background: #2D2A2E;
normal-foreground: #FCFCFA;
urgent-background: #AB9DF2;
urgent-foreground: #FCFCFA;

alternate-active-background: #FFD866;
alternate-active-foreground: #FCFCFA;
alternate-normal-background: #2D2A2E;
alternate-normal-foreground: #FCFCFA;
alternate-urgent-background: #2D2A2E;
alternate-urgent-foreground: #FCFCFA;

selected-active-background: #FC9867;
selected-active-foreground: #000000;
selected-normal-background: #FC9867;
selected-normal-foreground: #000000;
selected-urgent-background: #FC9867;
selected-urgent-foreground: #000000;

background-color: #2D2A2E;
background: rgba(0,0,0,0.7);
foreground: #FCFCFA;
border-color: #FC9867;

color0: #2D2A2E;
color1: #FF6188;
color2: #A9DC76;
color3: #FFD866;
color4: #FC9867;
color5: #AB9DF2;
color6: #78DCE8;
color7: #FCFCFA;
color8: #908E8F;
color9: #FF6188;
color10: #A9DC76;
color11: #FFD866;
color12: #FC9867;
color13: #AB9DF2;
color14: #78DCE8;
color15: #FCFCFA;


}


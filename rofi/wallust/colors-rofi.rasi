background-color: #1F1F20;
background: rgba(0,0,0,0.7);
foreground: #FDF1CC;
border-color: #2C58A0;

color0: #454546;
color1: #17161C;
color2: #17161C;
color3: #432922;
color4: #214278;
color5: #8E4728;
color6: #BCA152;
color7: #F4E2AE;

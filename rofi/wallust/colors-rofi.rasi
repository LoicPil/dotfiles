 /* wallust template - colors-rofi */

* {
active-background: #569CD6;
active-foreground: #D4D4D4;
normal-background: #1E1E1E;
normal-foreground: #D4D4D4;
urgent-background: #4EC9B0;
urgent-foreground: #D4D4D4;

alternate-active-background: #608B4E;
alternate-active-foreground: #D4D4D4;
alternate-normal-background: #1E1E1E;
alternate-normal-foreground: #D4D4D4;
alternate-urgent-background: #1E1E1E;
alternate-urgent-foreground: #D4D4D4;

selected-active-background: #569CD6;
selected-active-foreground: #000000;
selected-normal-background: #569CD6;
selected-normal-foreground: #000000;

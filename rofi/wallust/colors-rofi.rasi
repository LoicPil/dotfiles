 /* wallust template - colors-rofi */

* {
active-background: #2F7D7C;
active-foreground: #CCA75F;
normal-background: #241D1A;
normal-foreground: #CCA75F;
urgent-background: #B5896E;
urgent-foreground: #CCA75F;

alternate-active-background: #CCA75F;
alternate-active-foreground: #CCA75F;
alternate-normal-background: #241D1A;
alternate-normal-foreground: #CCA75F;
alternate-urgent-background: #241D1A;
alternate-urgent-foreground: #CCA75F;

selected-active-background: #2F7D7C;
selected-active-foreground: #000000;
selected-normal-background: #2F7D7C;
selected-normal-foreground: #000000;
selected-urgent-background: #2F7D7C;
selected-urgent-foreground: #000000;

background-color: #241D1A;
background: rgba(0,0,0,0.7);
foreground: #CCA75F;
border-color: #2F7D7C;

color0: #241D1A;
color1: #9F6434;
color2: #9DAC5F;
color3: #CCA75F;
color4: #2F7D7C;
color5: #B5896E;
color6: #52877F;
color7: #C7B8AC;
color8: #50413A;
color9: #9F6434;
color10: #9DAC5F;
color11: #CCA75F;

 /* wallust template - colors-rofi */

* {
active-background: #85CFED;
active-foreground: #786B53;
normal-background: #191919;
normal-foreground: #786B53;
urgent-background: #E14C5A;
urgent-foreground: #786B53;

alternate-active-background: #F2B732;
alternate-active-foreground: #786B53;
alternate-normal-background: #191919;
alternate-normal-foreground: #786B53;
alternate-urgent-background: #191919;
alternate-urgent-foreground: #786B53;

selected-active-background: #85CFED;
selected-active-foreground: #000000;
selected-normal-background: #85CFED;
selected-normal-foreground: #000000;
selected-urgent-background: #85CFED;
selected-urgent-foreground: #000000;

background-color: #191919;
background: rgba(0,0,0,0.7);
foreground: #786B53;
border-color: #85CFED;

color0: #321300;
color1: #B2270E;
color2: #44A900;
color3: #AA820C;
color4: #58859A;
color5: #97363D;
color6: #B25A1E;
color7: #786B53;
color8: #433626;
color9: #ED5D20;
color10: #55F238;
color11: #F2B732;
color12: #85CFED;
color13: #E14C5A;
color14: #F07D14;
color15: #FFC800;


}

